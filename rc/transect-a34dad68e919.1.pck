    "op": "==",
    "value": true
   }
  },
  {
   "id": "night",
   "ring": "",
   "clock": "runs",
   "words": "Sleep till morning",
   "after": [
    "lie"
   ],
   "when": {
    "path": "night_out.lying",
    "op": "==",
    "value": true
   },
   "done": {
    "any": [
     {
