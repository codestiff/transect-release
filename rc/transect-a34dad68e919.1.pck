	"migrated_from_spec": {
		"extent_m": 0.58,
		"class": "flower",
		"near_m": 0.41,
		"impostor_from_m": 86.69,
		"cull_at_m": 111.8,
		"mesh_rungs": 8.0,
		"tri_area_px2": 25.0,
		"tri_area_source": "class-prior",
		"rungs": [
			{
				"rung": 0.0,
				"from_m": 0.3,
				"to_m": 0.83,
				"px_tall_at_from": 1080.0,
				"tris_max_16px2": 43740.0,
				"tris_max_100px2": 6998.0,
				"error_target_mm": 0.39,
				"tris_est": 27993.0,
				"tris_range": [
					10935.0,
					58320.0
				]
			},
			{
				"rung": 1.0,
				"from_m": 0.83,
				"to_m": 1.66,
				"px_tall_at_from": 540.0,
				"tris_max_16px2": 10935.0,
				"tris_max_100px2": 1749.0,
				"error_target_mm": 1.07,
				"tris_est": 6998.0,
				"tris_range": [
					2733.0,
					14580.0
				]
			},
			{
				"rung": 2.0,
				"from_m": 1.66,
				"to_m": 3.31,
				"px_tall_at_from": 270.0,
				"tris_max_16px2": 2733.0,
				"tris_max_100px2": 437.0,
				"error_target_mm": 2.15,
				"tris_est": 1749.0,
