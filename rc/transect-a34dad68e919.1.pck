    },
    {
     "id": "low",
     "backdrop": "still",
     "sound": "ambience",
     "motion": "none",
     "cost": {
      "download_mb": 0.15,
      "memory_mb": 8,
      "frame_ms": 2,
      "ready_s": 0.2
     }
    }
   ]
  },
  "setting_off": {
   "state": "LOADING",
   "drawn_by": "engine",
   "purpose": "Only what the choice needs beyond FRONTEND's build, over the same picture and the same sound, so leaving the menu is a continuation and not a cut. Its line says what binds, its rate and what is left (D-ui-1).",
   "tiers": [
    {
     "id": "same_as_menu",
     "backdrop": "still",
     "sound": "music_and_ambience",
     "motion": "reduced",
     "cost": {
      "memory_mb": 0,
      "frame_ms": 4
     }
    }
   ]
  }
 },
 "platforms": {
  "web": {
   "path": [
    "page_splash",
    "title_menu",
    "setting_off"
   ],
   "draws": {
    "BOOT": "page_splash",
    "FRONTEND": "title_menu",
    "LOADING": "setting_off"
   },
   "notes": "The page must download the engine (36 MB) and the valley before the game can draw anything, so the splash is HTML and carries the identity alone. The title-menu's tier is chosen before the engine is fetched where the page can know (the memory probe), and confirmed by the governor's first menu frames."
  },
  "native": {
   "path": [
    "engine_splash",
    "title_menu",
    "setting_off"
   ],
   "draws": {
    "BOOT": "engine_splash",
    "FRONTEND": "title_menu",
    "LOADING": "setting_off"
   },
   "notes": "Nothing is downloaded: the engine starts from disk in about a second, so BOOT is the engine's boot image and is over before a player could read a bar."
  }
 },
 "budgets": {
  "phone_low": {
   "means": "a phone that gave the probe less than the walk's need, or one thread and a slow first frame",
   "chosen_by": "page/memprobe.js, then TrQuality's first menu frames",
   "first_paint_s": 1,
   "menu_interactive_s": 20,
   "to_first_step_s": 30,
   "download_mb": 52,
   "memory_mb": 384,
   "frame_ms": 33
  },
  "phone": {
   "means": "a recent phone (the owner's iPhone)",
   "chosen_by": "the probe gave the need; threads or not",
   "first_paint_s": 1,
   "menu_interactive_s": 15,
   "to_first_step_s": 20,
   "download_mb": 64,
   "memory_mb": 512,
   "frame_ms": 33
  },
  "desktop": {
   "means": "a desktop browser or a native build",
   "chosen_by": "pointer and a wide canvas, threads, or native",
   "first_paint_s": 1,
   "menu_interactive_s": 8,
   "to_first_step_s": 10,
   "download_mb": 64,
   "memory_mb": 1024,
   "frame_ms": 16.7
  }
 },
 "acceptance": [
  {
   "id": "A1",
   "says": "From the first paint, the game's name is on screen in its own type, the same on the page and in the game.",
   "proved_by": "a shot of the page splash beside the title-menu, web and native"
  },
  {
   "id": "A2",
   "says": "A first-time player is one click from walking: the primary choice is the tutorial night, with no question in between.",
   "proved_by": "a spec that counts the clicks from the title-menu to PLAYING on a fresh profile"
  },
  {
   "id": "A3",
   "says": "A returning player with a saved night is one click from walking, with no second load.",
   "proved_by": "a spec: carry_on reaches PLAYING with no scene reload"
  },
  {
   "id": "A4",
   "says": "Sound is heard on the title-menu from the first touch, and carries on, unbroken, into the walk.",
   "proved_by": "a play reads the music and ambience players' state across FRONTEND, LOADING and PLAYING"
  },
  {
   "id": "A5",
   "says": "Nothing interrupts the first look: no question sits over the title-menu on a first visit.",
   "proved_by": "a spec: no sheet is open over the title-menu before the first choice"
  },
  {
   "id": "A6",
   "says": "Every wait says what it waits on, how fast and what is left, and never appears frozen.",
   "proved_by": "plans 177, 203 and 181 (the watchdog)"
  },
  {
   "id": "A7",
   "says": "A device that cannot afford the hero picture is given a smaller one from the start, not after a stutter.",
   "proved_by": "a unit test choosing the tier from each budget, and a frame-time trace on the low phone"
  },
  {
   "id": "A8",
   "says": "Settings are reachable from the title-menu and from the pause.",
   "proved_by": "plans 076 and 052 (already true)"
  }
 ]
}
␀␀{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "res://src/delivery/start_flow.schema.json",
 "title": "THE START FLOW (docs/plans/226): from launch to the first step, as states, screens and their budgets",
 "description": "One file says what a player meets between opening the game and walking, on every platform and every device. States are the game's (BOOT, FRONTEND, LOADING, PLAYING, PAUSED); screens are what is drawn in a state; a screen has tiers, the most expensive first, and a device is given the best tier whose cost fits its budget -- the gameplay quality ladder's rule (src/delivery/quality.gd), applied to the menu. Each platform says which states it passes through and which screen draws each.",
 "type": "object",
 "required": ["version", "states", "screens", "platforms", "budgets", "acceptance"],
 "additionalProperties": false,
 "properties": {
  "_what": {"type": "string"},
  "version": {"const": 1},
  "states": {
   "description": "The game's states and the moves between them. A state is not a screen: Settings, the diagnostics question and the tutorial choice are overlays within FRONTEND.",
   "type": "object",
   "propertyNames": {"enum": ["BOOT", "FRONTEND", "LOADING", "PLAYING", "PAUSED"]},
   "additionalProperties": {
    "type": "object",
    "required": ["means", "to"],
    "additionalProperties": false,
    "properties": {
     "means": {"type": "string"},
     "to": {"type": "array", "items": {"enum": ["BOOT", "FRONTEND", "LOADING", "PLAYING", "PAUSED"]}},
     "skippable": {"type": "boolean", "description": "the player can cut it short (a splash, an intro); default false"}
    }
   }
  },
  "screens": {
   "type": "object",
   "additionalProperties": {"$ref": "#/$defs/screen"}
  },
  "platforms": {
   "description": "Which screen draws each state on this platform. A platform may skip a state (native has no page to download).",
   "type": "object",
   "propertyNames": {"enum": ["web", "native"]},
   "additionalProperties": {
    "type": "object",
    "required": ["path", "draws"],
    "additionalProperties": false,
    "properties": {
     "path": {"type": "array", "items": {"type": "string"}, "description": "the screens in the order a first-time player meets them"},
     "draws": {"type": "object", "additionalProperties": {"type": "string"}, "description": "state -> screen id"},
     "notes": {"type": "string"}
    }
   }
  },
  "budgets": {
   "description": "What the flow may cost, per device class. A tier is offered only if its cost fits.",
   "type": "object",
   "additionalProperties": {"$ref": "#/$defs/budget"}
  },
  "acceptance": {
   "description": "Player's sentences the flow is held to; each names how it is proved.",
   "type": "array",
   "items": {
    "type": "object",
    "required": ["id", "says", "proved_by"],
    "additionalProperties": false,
    "properties": {
     "id": {"type": "string", "pattern": "^A[0-9]+$"},
     "says": {"type": "string"},
     "proved_by": {"type": "string"}
    }
   }
  }
 },
 "$defs": {
  "screen": {
   "type": "object",
   "required": ["state", "drawn_by", "purpose", "tiers"],
   "additionalProperties": false,
   "properties": {
    "state": {"enum": ["BOOT", "FRONTEND", "LOADING", "PLAYING", "PAUSED"]},
    "drawn_by": {"enum": ["page", "engine_splash", "engine"], "description": "the HTML page before the engine, the engine's own boot image, or the game"},
    "purpose": {"type": "string"},
    "choices": {
     "type": "array",
     "items": {
      "type": "object",
      "required": ["id", "label", "goes"],
      "additionalProperties": false,
      "properties": {
       "id": {"type": "string"},
       "label": {"type": "string"},
       "goes": {"type": "string", "description": "a state, or an overlay's id"},
       "when": {"type": "string", "description": "the condition it is shown under (a saved night, first visit ...)"},
       "primary": {"type": "boolean"}
      }
     }
    },
    "overlays": {"type": "array", "items": {"type": "string"}},
    "tiers": {
     "description": "Most expensive first. The first whose cost fits the device's budget is drawn; the last must fit every budget.",
     "type": "array",
     "minItems": 1,
     "items": {"$ref": "#/$defs/tier"}
    }
   }
  },
  "tier": {
   "type": "object",
   "required": ["id", "backdrop", "sound", "cost"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string"},
    "backdrop": {"enum": ["live_valley", "flyover", "still", "colour"], "description": "the live 3D valley, a pre-rendered loop, one picture, or a flat colour"},
    "sound": {"enum": ["music_and_ambience", "ambience", "none"]},
    "motion": {"enum": ["full", "reduced", "none"], "description": "camera drift, fades, the title's reveal"},
    "cost": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "download_mb": {"type": "number", "description": "bytes the page must fetch before this tier can draw, beyond the engine"},
      "memory_mb": {"type": "number", "description": "heap it holds while shown"},
      "frame_ms": {"type": "number", "description": "the frame it costs at the menu's frame rate"},
      "ready_s": {"type": "number", "description": "seconds from engine-up until it can draw, on the reference phone"}
     }
    }
   }
  },
  "budget": {
   "type": "object",
   "required": ["means", "chosen_by"],
   "additionalProperties": false,
   "properties": {
    "means": {"type": "string"},
    "chosen_by": {"type": "string", "description": "the signal that puts a device in this class (the memory probe, threads, the governor's first frames)"},
    "first_paint_s": {"type": "number", "description": "launch to the game's name on screen"},
    "menu_interactive_s": {"type": "number", "description": "launch to a primary choice that answers"},
    "to_first_step_s": {"type": "number", "description": "the primary choice to the first step, for a returning player"},
    "download_mb": {"type": "number"},
    "memory_mb": {"type": "number"},
    "frame_ms": {"type": "number"}
   }
  }
 }
}
