   "done": {
    "path": "night_out.pack.water_l",
    "op": ">=",
    "value": 0.9
   }
  },
  {
   "id": "arrive",
   "ring": "",
   "beacon": "shore",
   "words": "The fishing station is a day's walk. Be there before dark.",
   "after": [
    "night",
    "breakfast",
    "stow",
    "strike"
   ],
   "when": {
    "path": "night_out.morning",
    "op": "==",
    "value": true
