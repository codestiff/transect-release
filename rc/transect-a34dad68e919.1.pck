      "op": "==",
      "value": true
     },
     {
      "path": "night_out.dawn_pending",
      "op": "==",
      "value": true
     }
    ]
   },
   "welcomes": true
  },
  {
   "id": "breakfast",
   "ring": "pack:oatcakes",
   "beacon": "",
   "words": "Eat before you set off",
   "after": [
    "night"
   ],
   "when": {
    "path": "night_out.morning",
    "op": "==",
    "value": true
   },
   "done": {
    "path": "night_out.breakfast_kcal",
    "op": ">=",
    "value": 1000
   }
  },
  {
   "id": "stow",
   "action": "stow_bag",
   "ring": "pack:bag",
   "beacon": "bag",
   "words": "Roll up your bag",
   "after": [
    "night"
   ],
   "when": {
    "path": "night_out.morning",
    "op": "==",
    "value": true
   },
   "done": {
    "path": "night_out.pack.items",
    "op": "has",
    "value": "bag"
   },
   "keep": true
  },
  {
   "id": "strike",
   "action": "strike_tent",
   "ring": "pack:tent",
   "beacon": "tent",
   "words": "Pack up your tent",
   "after": [
    "night",
    "stow"
   ],
   "when": {
    "path": "night_out.morning",
    "op": "==",
    "value": true
   },
   "done": {
    "path": "night_out.tent.pitched",
    "op": "==",
    "value": false
   },
   "keep": true
  },
  {
   "id": "refill",
   "action": "drink",
   "ring": "act_when:drink",
   "beacon": "water",
   "words": "Fill your bottle at the burn",
   "keep": true,
   "after": [
    "night"
   ],
   "when": {
    "all": [
     {
      "path": "night_out.morning",
      "op": "==",
      "value": true
     },
     {
      "path": "night_out.pack.water_l",
      "op": "<",
      "value": 0.05
     },
     {
      "path": "night_out.body.water_deficit_l",
      "op": ">=",
      "value": 0.7
     }
    ]
