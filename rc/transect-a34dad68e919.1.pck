			},
			{
				"rung": 3.0,
				"from_m": 3.31,
				"to_m": 6.63,
				"px_tall_at_from": 135.0,
				"tris_max_16px2": 683.0,
				"tris_max_100px2": 109.0,
				"error_target_mm": 4.3,
