 "_what": "THE BUDGETS PER PROFILE, IN THE PROFILE (docs/plans/104; proposed by the performance seat in test/ledger/perf_ledger/budgets.json, carried here by delivery). Each cap: its maximum, where it is measured ('bench': tools/bench-ledger.py; 'device': a device's own report, the page's diagnostics) and its source. TrProfile.budgets is its profile's row; test/suite_delivery.gd holds every number to the performance seat's file until tools/bench-ledger.py reads them from here, and that file keeps only its tolerances, its owners and the litter's allowance.",
 "profiles": {
  "web-review": {
   "draw_calls_p95": {
    "max": 300,
    "on": "bench",
    "source": "docs/plans/001 (the owner's iPhone, iOS 18.7): 293 draw calls held 58 fps at the top level and 244 held 59; no phone has been measured holding more"
   },
   "draw_calls_median": {
    "max": 300,
    "on": "bench",
    "source": "as draw_calls_p95: a phone's frame at the median must also fit"
   },
   "scripts_ms": {
    "max": 8.0,
    "on": "bench",
    "source": "half the 60 Hz frame (16.7 ms) for the scripts, the other half the engine's culling and submission (docs/plans/004's processor time); the bench machine is faster than a phone, so over here is over there"
   },
   "triangles_p95": {
    "max": 1400000,
    "on": "bench",
    "source": "docs/plans/006: subjects 600k and grass at their caps plus the ground and the shadow pass; the iPhone held 1.04M at 58 fps (docs/plans/001)"
   },
   "load_ms": {
    "max": 10000,
    "on": "device",
    "source": "the-walks-technical-challenges (the library's fable plan) step 1's gate: ready in under ten seconds, then five at its step 7"
   },
   "audio_mb": {
    "max": 30,
    "on": "device",
    "source": "the-walks-technical-challenges step 3's gate: audio held under 30 MB on the memory line"
   },
   "envelope_mb": {
    "max": 64,
    "on": "device",
    "source": "CHARTER: the web artifact's 64 MB, tools/build-web.sh reports it"
   }
  },
  "native-desktop": {
   "scripts_ms": {
    "max": 8.0,
    "on": "bench",
    "source": "as web-review: half a 60 Hz frame for the scripts"
   },
   "draw_calls_p95": {
    "max": 1000,
    "on": "bench",
    "source": "no device evidence yet: the bench baseline (2026-10-03) with room for the desktop's longer reach; the ledger holds it from here"
   },
   "load_ms": {
    "max": 10000,
    "on": "device",
    "source": "the-walks-technical-challenges step 1: ten seconds, on the M1 Max desktop it measured at 23.4 s"
   }
  },
  "native-mobile": {
   "draw_calls_p95": {
    "max": 300,
    "on": "device",
    "source": "as web-review: the phone's own evidence (docs/plans/001)"
   },
   "load_ms": {
    "max": 10000,
    "on": "device",
    "source": "as web-review"
   }
  },
  "native-desktop-4k": {
   "draw_calls_p95": {
    "max": 1000,
    "on": "bench",
    "source": "as native-desktop: a draw call does not grow with the pixels; the 4K profile raises the triangles (docs/plans/107), not the calls"
   },
   "triangles_p95": {
    "max": 8000000,
    "on": "bench",
    "source": "the profile's own frame budgets (docs/plans/107): subjects 4.8M and grass 2.8M (the desktop's 1.2M and 700k times 4, one halving finer), the ground and the shadow pass in the rest"
   },
   "texture_mb": {
    "max": 2048,
    "on": "bench",
    "source": "a start, not a measurement: an eighth of a 16 GB Mac's unified memory, the smallest Apple silicon the owner's 4K test would meet; replaced by the first 4K device report"
   },
   "scripts_ms": {
    "max": 8.0,
    "on": "bench",
    "source": "as native-desktop: half a 60 Hz frame"
   },
   "load_ms": {
    "max": 10000,
    "on": "device",
    "source": "as native-desktop"
   }
  },
  "norge-web": {
   "draw_calls_p95": {
    "max": 300,
    "on": "bench",
    "source": "as web-review: the Norge dev build runs on the phone's profile, so the phone's caps -- docs/plans/001 (the owner's iPhone, iOS 18.7): 293 draw calls held 58 fps at the top level and 244 held 59; no phone has been measured holding more"
   },
   "draw_calls_median": {
    "max": 300,
    "on": "bench",
    "source": "as web-review: the Norge dev build runs on the phone's profile, so the phone's caps -- as draw_calls_p95: a phone's frame at the median must also fit"
   },
   "scripts_ms": {
    "max": 8.0,
    "on": "bench",
    "source": "as web-review: the Norge dev build runs on the phone's profile, so the phone's caps -- half the 60 Hz frame (16.7 ms) for the scripts, the other half the engine's culling and submission (docs/plans/004's processor time); the bench machine is faster than a phone, so over here is over there"
   },
   "triangles_p95": {
    "max": 1400000,
    "on": "bench",
    "source": "as web-review: the Norge dev build runs on the phone's profile, so the phone's caps -- docs/plans/006: subjects 600k and grass at their caps plus the ground and the shadow pass; the iPhone held 1.04M at 58 fps (docs/plans/001)"
   }
  }
 }
