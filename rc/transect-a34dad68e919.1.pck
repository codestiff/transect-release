  "content": "norge",
  "ruleset": {
   "forgiving": false,
   "rules": "camp",
   "actions": "camp",
   "dials": {}
  },
  "modes": {
   "dev": {
    "download_budget_mb": 64,
    "tools": true,
    "scenario_dials": true,
    "free_walk": true
   },
   "hosted": {
    "download_budget_mb": 0,
    "tools": false,
