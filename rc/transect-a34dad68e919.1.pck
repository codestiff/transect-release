␀␀␀␀␀␀{
 "_what": "THE FIELD GUIDE'S WORDS (docs/plans/027): what an inspected subject is, for a player -- its name, its kind, and a short, playful line. Ours, written by hand; the facts beside them (scientific name, family, heights) come from the library's taxa through tools/field_guide.gd. Every subject the game shows has an entry here (suite game). `interest` ranks what a tap names when several are near it (docs/plans/029): 3 an animal, 2 food, fuel and the trees, 1 the rest.",
 "rowan": {
  "name": "Rowan",
  "kind": "tree",
  "words": "Also called mountain ash, though it is no ash: it is a cousin of the rose. Its scarlet berries feed the thrushes all autumn. Raw they are bitter; cooked, they will do.",
  "interest": 2
 },
 "birch": {
  "name": "Downy birch",
  "kind": "tree",
  "words": "The white-barked pioneer of wet glens. Its papery bark peels away in curls, and catches a spark better than almost anything else in the valley.",
  "interest": 2
 },
 "pine": {
  "name": "Pine",
  "kind": "tree",
  "words": "A tree of the old Caledonian wood. Its fallen limbs are the best firewood in the glen, and its needles smell of resin when you crush them.",
  "interest": 2
 },
 "bramble": {
  "name": "Bramble",
  "kind": "shrub",
  "words": "Blackberries in late summer, thorns all year round. Pick from the outside -- the best ones are always just out of reach.",
  "interest": 2
 },
 "buttercup": {
  "name": "Meadow buttercup",
  "kind": "flower",
  "words": "Cheerful, glossy and poisonous to eat. The grazing animals know to leave it standing.",
  "interest": 1
 },
 "dock": {
  "name": "Dock",
  "kind": "plant",
  "words": "Big, broad leaves by the path. Old wisdom says rub one on a nettle sting; it mostly works by giving you something to do.",
  "interest": 1
 },
 "fireweed": {
  "name": "Rosebay willowherb",
  "kind": "flower",
  "words": "Fireweed: the first to flower where ground has burned or been broken. In autumn its seeds drift away on silk.",
  "interest": 1
 },
 "rattle": {
  "name": "Yellow rattle",
  "kind": "flower",
  "words": "A meadow plant that quietly steals from the grass roots around it. When the seeds ripen, the pods rattle as you brush past.",
  "interest": 1
 },
 "fern": {
  "name": "Fern",
  "kind": "fern",
  "words": "Unrolled from tight fiddleheads in spring; by autumn the valley's ferns have turned the colour of rust.",
  "interest": 1
 },
 "moss": {
  "name": "Moss",
  "kind": "moss",
  "words": "A cushion of moss, holding the rain like a sponge. Lovely to look at. Terrible to sleep on.",
  "interest": 1
 },
 "hare": {
  "name": "Mountain hare",
  "kind": "animal",
  "words": "Brown in summer, white in winter, and gone in a blink if you come too close. These hills have been its home since the Ice Age.",
  "interest": 3
 },
 "deadwood": {
  "name": "Fallen trunk",
  "kind": "dead wood",
  "words": "A pine that came down in a storm, drying where it lies. Dead wood like this is tonight's fire: walk up to it and press ACT.",
  "interest": 2
 },
 "sticks": {
  "name": "Fallen birch",
  "kind": "dead wood",
  "words": "Birch limbs the wood has dropped, white bark and all. Light, dry kindling: press ACT to take an armful.",
  "interest": 2
 },
 "erratic": {
  "name": "Erratic",
  "kind": "boulder",
  "words": "A boulder the ice carried here and left when it melted, ten thousand years ago. The lichen on it grows a few millimetres a century.",
  "interest": 1
 },
 "shore": {
  "name": "Fishing station",
  "kind": "building",
  "words": "A fisherman's red cabin and a quay warehouse at the head of the beach, where the burn meets the sea loch. Nobody has worked the loch from here for years.",
  "interest": 2
 },
 "_not_inspected": {
  "_why": "The owner, 2026-10-01: 'keep it to interesting subjects ... I wouldn't expect to inspect a rock'. The game shows these, and a tap on them names nothing.",
  "subjects": [
   "sward",
   "tuft",
   "block",
   "shelter",
   "boulder",
   "pebble",
   "campfire",
   "chocolate",
   "sleeping_bag"
  ]
